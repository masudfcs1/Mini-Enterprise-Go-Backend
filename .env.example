# Application Configuration
PORT=8080
ENV=development

# Database Connection (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/go_backend?sslmode=disable"

# Enterprise Authentication & Security Secrets
JWT_ACCESS_SECRET=replace-with-a-unique-random-secret-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-another-unique-random-secret-at-least-32-characters
AUTH_TOKEN_SECRET=replace-with-an-auth-challenge-hmac-secret-at-least-32-characters
COOKIE_SECRET=replace-with-a-cookie-secret-at-least-32-characters
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
JWT_REFRESH_REMEMBER_EXPIRES=30d
JWT_ISSUER=enterprise-backend
JWT_AUDIENCE=enterprise-api
AUTH_TOKEN_TRANSPORT=cookie
